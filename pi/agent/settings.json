{
  "lastChangelogVersion": "0.84.2",
  "theme": "opencode-shade",
  "defaultProvider": "opencode",
  "defaultModel": "big-pickle",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:@juicesharp/rpiv-btw",
    {
      "source": "npm:pi-subagents",
      "extensions": [
        "+src/extension/index.ts",
        "-index.ts"
      ]
    },
    "npm:@raquezha/noleaks@0.0.5",
    "npm:pi-mcp-adapter",
    "git:github.com/dmmulroy/pi-web-tools"
  ],
  "extensions": [
    "+extensions/usage-dashboard/index.ts"
  ],
  "subagents": {
    "watchdog": {
      "enabled": true,
      "main": {
        "enabled": true,
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium"
      }
    }
  }
}
