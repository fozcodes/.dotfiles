{
  "mcpServers": {
    "searxng": {
      "command": "npx",
      "args": ["-y", "mcp-searxng"],
      "env": {
        "SEARXNG_URL": "http://127.0.0.1:8989/",
        "SEARXNG_FANOUT": "false",
          "SEARXNG_TIMEOUT_MS": "10000",
          "SEARXNG_MAX_RESULTS": "5",
          "SEARXNG_HTML_FALLBACK": "true"
      }
    }
  }
}
